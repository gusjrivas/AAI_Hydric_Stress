+const format=d=>new Date(d+'T12:00:00Z').toLocaleDateString('es-AR',{day:'numeric',month:'short',timeZone:'UTC'});
+function chart(svg,values,labels){const w=Math.max(230,Math.round(svg.getBoundingClientRect().width)||420),h=178,left=39,right=14,top=16,bottom=33;svg.setAttribute('viewBox',`0 0 ${w} ${h}`);const xx=i=>left+i*(w-left-right)/Math.max(1,values.length-1);const yy=v=>top+(40-v)/30*(h-top-bottom);let markup='';[10,20,30,40].forEach(v=>{markup+=`<line class="farm-grid" x1="${left}" x2="${w-right}" y1="${yy(v)}" y2="${yy(v)}"/><text x="${left-8}" y="${yy(v)+4}" text-anchor="end">${v}%</text>`;});let pen=false;let path='';values.forEach((v,i)=>{if(v==null){pen=false;return;}path+=`${pen?'L':'M'}${xx(i)},${yy(v)} `;pen=true;});markup+=`<path class="farm-plot" d="${path}"/>`;[0,Math.floor((values.length-1)/2),values.length-1].forEach(i=>markup+=`<text x="${xx(i)}" y="${h-8}" text-anchor="${i===0?'start':i===values.length-1?'end':'middle'}">${labels[i]}</text>`);values.forEach((v,i)=>{if(v!=null)markup+=`<circle cx="${xx(i)}" cy="${yy(v)}" r="3" fill="var(--farm-accent)"><title>${labels[i]}: ${v}%</title></circle>`;});svg.innerHTML=markup;}
+function draw(){const data=sectors[state.sector];const dates=Array.from({length:7},(_,i)=>`${12+i} sept`);qa('[data-chart]').filter(s=>!s.closest('[hidden]')).forEach(svg=>{let vals=[...data.values],labels=dates;if(svg.dataset.chart==='long'&&state.period===30){vals=Array.from({length:23},(_,i)=>Math.round(32+3*Math.sin(i*.55)));vals[11]=null;vals.push(...data.values);labels=Array.from({length:30},(_,i)=>{const d=new Date(Date.UTC(2026,7,20+i));return d.toLocaleDateString('es-AR',{day:'numeric',month:'short',timeZone:'UTC'});});}chart(svg,vals,labels);});}
+function render(){const d=sectors[state.sector];root.dataset.compact=choices.compact;q('#farm-sector').value=state.sector;q('#farm-period').value=String(state.period);qa('[data-view]').forEach(el=>el.hidden=el.dataset.view!==state.page);qa('[data-page]').forEach(b=>{if(b.dataset.page===state.page)b.setAttribute('aria-current','page');else b.removeAttribute('aria-current');});q('#farm-title').textContent=d.name;q('#farm-title').nextElementSibling.textContent=d.crop+' · 18 de septiembre de 2026';qa('[data-sectorlabel]').forEach(el=>el.textContent=d.name);q('#farm-moisture').textContent=d.values.at(-1)+' %';q('#farm-last').textContent=d.values.at(-1)+' %';const stale=choices.scenario==='sin-actualizar';q('#farm-fresh').textContent=stale?'Últimos datos: hoy, 18 de septiembre':'Últimos datos: hoy, 18 de septiembre';q('#farm-message').textContent=stale?'Pronóstico todavía no disponible':state.sector==='norte'?'Atención para el lunes 21':'No se prevén alertas en estos 3 días';q('#farm-guidance').textContent=stale?'Hay mediciones guardadas, pero todavía no hay estimaciones para los próximos días.':state.sector==='norte'?'Se estima una posible falta de agua. Revisá el suelo y el cultivo.':'Seguí observando el suelo y el cultivo.';q('#farm-days').innerHTML=d.risks.map((risk,i)=>`<article class="farm-day ${!stale&&risk>=50?'is-alert':''}"><div class="farm-dayhead"><h3>${['Mañana','Domingo','Lunes'][i]}</h3><span class="farm-small">${19+i} sept</span></div><div class="farm-risk"><div class="farm-percent">${stale?'—':risk+' %'}</div><p class="farm-small">${stale?'Sin estimación':'Posibilidad de falta de agua'}</p></div><div class="farm-track" aria-hidden="true"><span style="width:${stale?0:risk}%"></span></div><div class="farm-status">${stale?'Sin pronóstico':risk>=50?'⚠ Alerta':'○ Sin alerta'}</div></article>`).join('');q('#farm-values').innerHTML=d.values.map((v,i)=>`<tr><td>${12+i} sept</td><td>${v} %</td><td>${[22,23,25,24,26,25,24][i]} °C</td><td>${i===1?'2':'0'} mm</td></tr>`).reverse().join('');renderNotes();draw();}
+function renderNotes(){const list=q('#farm-notes');list.replaceChildren();const notes=state.notes.filter(n=>n.sector===state.sector);if(!notes.length){const p=document.createElement('p');p.className='farm-small';p.textContent='Todavía no registraste observaciones en este ejemplo.';list.append(p);return;}notes.forEach(n=>{const a=document.createElement('article');a.className='farm-box';a.style.marginBottom='10px';const p=document.createElement('p');p.className='farm-small';p.textContent=format(n.date)+' · '+n.subject;const text=document.createElement('p');text.textContent=n.text;a.append(p,text);list.append(a);});}
+function navigate(page){state.page=page;render();save();}
+qa('[data-page]').forEach(b=>b.onclick=()=>navigate(b.dataset.page));qa('[data-go]').forEach(b=>b.onclick=()=>navigate(b.dataset.go));q('#farm-sector').onchange=e=>{state.sector=e.target.value;q('#farm-confirm').hidden=true;render();q('#farm-announcement').textContent='Mostrando '+sectors[state.sector].name;save();};q('#farm-period').onchange=e=>{state.period=Number(e.target.value);draw();save();};q('#farm-help-toggle').onclick=()=>{const panel=q('#farm-help');panel.hidden=!panel.hidden;q('#farm-help-toggle').setAttribute('aria-expanded',String(!panel.hidden));};q('#farm-form').onsubmit=e=>{e.preventDefault();const text=q('#farm-note').value.trim();if(!text){q('#farm-note').setCustomValidity('Escribí qué observaste.');q('#farm-note').reportValidity();return;}state.notes.unshift({sector:state.sector,date:q('#farm-date').value,subject:q('input[name="farm-subject"]:checked').value,text});q('#farm-note').value='';q('#farm-confirm').hidden=false;q('#farm-confirm').className='farm-ok';q('#farm-confirm').textContent='Observación de ejemplo guardada en '+sectors[state.sector].name+'.';renderNotes();};q('#farm-note').oninput=()=>q('#farm-note').setCustomValidity('');
+window.addEventListener('openai:set_globals',e=>{if(e.detail?.globals?.widgetState){restore(e.detail.globals.widgetState);render();}});
+render();new ResizeObserver(draw).observe(root);
+if(globalThis.Tweak){const tweak=new Tweak({container:root,onChange:()=>{render();save();}});tweak.addSelect(choices,'scenario',{label:'Estado para revisar',options:[{label:'Pronóstico disponible',value:'actualizado'},{label:'Pronóstico no disponible',value:'sin-actualizar'}]});tweak.addToggle(choices,'compact',{label:'Tarjetas compactas'});}
+})();
+</script>
+</div>
