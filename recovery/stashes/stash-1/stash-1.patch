+<script>
+(()=>{
+const root=document.getElementById('cultivo-claro');
+const q=s=>root.querySelector(s);const qa=s=>[...root.querySelectorAll(s)];
+const choices={compact:false,scenario:'actualizado'};
+const sectors={norte:{name:'Huerta norte',crop:'Tomate',values:[31,30,28,27,25,24,22],risks:[20,40,75]},sur:{name:'Huerta sur',crop:'Lechuga',values:[30,31,30,32,31,30,31],risks:[15,22,30]}};
+let state={page:'inicio',sector:'norte',period:7,notes:[]};
+const restore=s=>{const p=s?.privateContent;if(!p)return;if(sectors[p.sector])state.sector=p.sector;if(['inicio','mediciones','observaciones'].includes(p.page))state.page=p.page;if([7,30].includes(p.period))state.period=p.period;};
+restore(window.openai?.widgetState);
