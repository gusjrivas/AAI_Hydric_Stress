index 0000000..e806900
--- /dev/null
+++ b/frontend/src/features/summary/HistoryPanel.css
@@ -0,0 +1,23 @@
+.history-panel { padding: clamp(16px, 3vw, 28px); border: 1px solid var(--color-border); border-radius: 12px; background: var(--color-surface); }
+.history-panel p { margin: 8px 0 16px; max-width: 75ch; }
+.history-header { display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
+.history-header h3 { margin: 0 0 12px; font-size: clamp(1.15rem, 2vw, 1.45rem); }
+.history-header label { display: flex; flex-direction: column; gap: 6px; font-size: .85rem; }
+.history-header select { padding: 10px; min-height: 44px; max-width: 100%; }
+.history-eyebrow { color: var(--color-action); font-weight: 700; font-size: .85rem; }
+.history-metrics { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin: 20px 0; }
+.history-metrics dt { font-size: .85rem; }
+.history-metrics dd { margin: 6px 0; font-size: clamp(1rem, 2.5vw, 1.5rem); font-weight: 700; }
+.history-origin { font-weight: 600; }
+.history-chart { margin: 20px 0; }
