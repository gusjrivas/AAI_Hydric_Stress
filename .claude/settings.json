{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-pr-traceability.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-issue-close-evidence.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/remind-close-issues-after-merge.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
