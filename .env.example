# Plantilla de variables de entorno para docker-compose.yml (ADR-0004).
# Copiar a .env (gitignorado) y ajustar si hace falta; estos son valores
# de desarrollo local, no credenciales de producción.

POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow
POSTGRES_DB=mlflow

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Variables que debe leer el código de HU3/HU4 al registrar experimentos:
# También la lee el backend de alerting-ui desde ADR-0006 (recalibración).
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Dataset que usa el endpoint de ingesta de sensores en vivo (ADR-0007).
# Si se omite, el backend RECHAZA escribir (ver backend/app/routers/sensors.py)
# en vez de caer silenciosamente sobre el dataset histórico de evidencia
# de tesis (melchor_romero_2024_consolidado).
ALERTING_UI_DATASET=sensores_en_vivo
