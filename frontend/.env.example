# Plantilla de variables de entorno del frontend (Vite). Copiar a
# `frontend/.env` (gitignorado) para apuntar a un backend distinto de
# localhost. No se requiere para levantar la demo en desarrollo local.

# URL base de la API del backend (ADR-0003). http://localhost:8000 es el
# valor por defecto de desarrollo si esta variable no se define.
VITE_API_BASE_URL=http://localhost:8000

# URL base del controlador local opcional de demostración acelerada
# (HU6, ADR-0012, openspec/changes/add-accelerated-sensor-demo/). Sin
# valor por defecto: si no se define, la vista "Demostración" no
# aparece y la aplicación funciona exactamente igual que sin ella. Solo
# tiene sentido si ya se preparó una sesión por CLI y se levantó
# `python -m scripts.demo_simulation serve` (ver scripts/demo_simulation/README.md).
# VITE_DEMO_CONTROL_BASE_URL=http://127.0.0.1:8010
